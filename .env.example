#--------------------------------------------------------------------
# Invoice module environment. Copy to .env and fill in the real values.
# Don't share or commit .env: it holds credentials.
#--------------------------------------------------------------------

CI_ENVIRONMENT = 'development'
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# Zoho Books connection
#--------------------------------------------------------------------

invoice.zohoClientId = 'REPLACE_ME'
invoice.zohoClientSecret = 'REPLACE_ME'
invoice.zohoRefreshToken = 'REPLACE_ME'
invoice.zohoOrgId = 'REPLACE_ME'

#--------------------------------------------------------------------
# App login (single user)
# Generate the hash once on the command line:
#   php -r "echo password_hash('your-password-here', PASSWORD_DEFAULT), PHP_EOL;"
# and paste the output as appPasswordHash.
#--------------------------------------------------------------------

invoice.appUsername = 'REPLACE_ME'
invoice.appPasswordHash = 'REPLACE_ME'

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------

database.default.hostname = 'localhost'
database.default.database = 'local'
database.default.username = 'root'
database.default.password = 'root'

